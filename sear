const targetSelect = document.querySelector('div[role="combobox"] + select'); 
const observer = new MutationObserver((mutations, obs) => {
  const select = document.querySelector('select[aria-hidden="true"]');

  if (select && select.options.length > 1) {
    console.log('Combobox options loaded!', select);
    obs.disconnect();
    var ref = document.querySelector("body > div > main > div > div:nth-child(4) > div > h3").textContent;
    if (ref.includes("Easy")){
    
    (async function searchShipsSequentially() {
      const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
      function setElementValue(element, value) {
        if (!element) return;
        const prototype = element.tagName === 'SELECT'
          ? window.HTMLSelectElement.prototype
          : window.HTMLInputElement.prototype;
    
        const valueSetter = Object.getOwnPropertyDescriptor(prototype, 'value')?.set;
    
        if (valueSetter) {
          valueSetter.call(element, value);
        } else {
          element.value = value;
        }
    
        ['input', 'change', 'blur'].forEach((eventType) => {
          element.dispatchEvent(new Event(eventType, { bubbles: true }));
        });
      }
      let selects = document.querySelectorAll('fieldset select');
      if (selects[0]) {
        setElementValue(selects[0], FrmDt);
        console.log('Step 1: Selected "From" ('+FrmDt+')');
      } else {
        console.warn('Step 1: "From" element not found.');
      }
      await delay(1500);
      selects = document.querySelectorAll('fieldset select');
      if (selects[1]) {
        setElementValue(selects[1], ToDt);
        console.log('Step 2: Selected "To" ( '+ToDt+' )');
      } else {
        console.warn('Step 2: "To" element not found.');
      }
      await delay(1000);
      const dateInput = document.querySelector('.react-datepicker__input-container input');
      if (dateInput) {
        setElementValue(dateInput, TrvDt);
        console.log('Step 3: Set date (' + TrvDt + ')');
      } else {
        console.warn('Step 3: Date input element not found.');
      }
      await delay(1000);
      const searchBtn = document.querySelector('button[type="submit"]');
      if (searchBtn) {
        searchBtn.click();
        console.log('Step 4: Search button clicked.');
      } else {
        console.warn('Step 4: Search button not found.');
      }
    })();
    }
  }
});

observer.observe(document.body, { 
  childList: true, 
  subtree: true, 
  attributes: true, 
  characterData: true 
});   
var checkUrl = setInterval(function () {
    if (!window.location.href.includes("add-permit")) {
        console.log("Waiting for add-permit page...");
        return;
    }
    clearInterval(checkUrl);
    console.log("add-permit detected:", window.location.href);
    var input = document.querySelector("#permit-application-no");
    var button = document.querySelector('button[type="submit"]');
    if (!input || !button) {
        console.error("Permit input or Submit button not found.");
        return;
    }
    var nativeSetter = Object.getOwnPropertyDescriptor(
        HTMLInputElement.prototype,
        "value"
    ).set;
    input.focus();
    nativeSetter.call(input, "");
    input.dispatchEvent(new Event("input", {
        bubbles: true,
        composed: true
    }));
    var i = 0;
    function typeCharacter() {
        if (i >= permitNo.length) {
            console.log("Finished typing:", input.value);
            input.dispatchEvent(new Event("change", {
                bubbles: true,
                composed: true
            }));

            input.dispatchEvent(new Event("blur", {
                bubbles: true
            }));
            console.log("Submitting in .7 seconds...");
            setTimeout(function () {
                var form = input.closest("form");
                if (form) {
                    console.log("Submitting form...");
                    if (typeof form.requestSubmit === "function") {
                        form.requestSubmit(button);
                    } else {
                        button.click();
                    }
                } else {
                    console.log("Clicking submit button...");
                    button.click();
                }

            }, 700);
            return;
        }
        var char = permitNo[i];
        input.focus();
        input.setSelectionRange(
            input.value.length,
            input.value.length
        );
        input.dispatchEvent(new KeyboardEvent("keydown", {
            key: char,
            code: "Digit" + char,
            bubbles: true,
            composed: true
        }));
        nativeSetter.call(input, input.value + char);
        input.dispatchEvent(new InputEvent("input", {
            bubbles: true,
            composed: true,
            inputType: "insertText",
            data: char
        }));
        input.dispatchEvent(new KeyboardEvent("keyup", {
            key: char,
            code: "Digit" + char,
            bubbles: true,
            composed: true
        }));
        console.log("Typed:", input.value);
        i++;
        setTimeout(typeCharacter, 200);
    }
    typeCharacter();

}, 1000);


